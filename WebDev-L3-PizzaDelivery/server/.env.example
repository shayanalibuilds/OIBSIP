# Server environment - copy to .env and fill in.
# NEVER commit a real .env file.

# App
PORT=5000
NODE_ENV=development

# MongoDB - leave blank to use the in-memory dev adapter.
# Local: mongodb://127.0.0.1:27017/ovenly
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/ovenly
MONGODB_URI=

# JWT - generate strong random strings, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access token lifetime (e.g. 15m) and refresh token lifetime (e.g. 7d)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Client
CLIENT_URL=http://localhost:5173

# SMTP - Ethereal or Mailtrap test credentials work fine.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ovenly <noreply@ovenly.dev>

# Admin bootstrap (used by `npm run seed`). Never created via public register.
ADMIN_EMAIL=admin@ovenly.dev
ADMIN_PASSWORD=
ADMIN_NAME=Ovenly Admin

# Razorpay TEST mode keys only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Low-stock scan schedule (node-cron expression).
LOW_STOCK_CRON=*/15 * * * *
